from typing import List, Tuple

from .color_triplet import ColorTriplet
from .palette import Palette

class TerminalTheme:
    def __init__(
        self,
        background: Tuple[int, int, int],
        foreground: Tuple[int, int, int],
        normal: List[Tuple[int, int, int]],
        bright: List[Tuple[int, int, int]],
    ) -> None: ...
    
    @property
    def background_color(self) -> ColorTriplet: ...
    
    @property
    def foreground_color(self) -> ColorTriplet: ...
    
    @property
    def ansi_colors(self) -> Palette: ...

DEFAULT_TERMINAL_THEME: TerminalTheme = ...
MONOKAI: TerminalTheme = ...
DIMMED_MONOKAI: TerminalTheme = ...
NIGHT_OWLISH: TerminalTheme = ...
SVG_EXPORT_THEME: TerminalTheme = ...