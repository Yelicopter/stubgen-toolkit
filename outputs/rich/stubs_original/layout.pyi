from _typeshed import Incomplete
from typing import Any, Dict, Iterable, List, NamedTuple, Optional, Sequence, Tuple, Union

class LayoutRender(NamedTuple):
    region: Any
    lines: Any

RegionMap: Incomplete
RenderMap: Incomplete

class LayoutError(Exception): ...
class NoSplitter(LayoutError): ...

class _Placeholder:
    def __init__(self, layout: Any, style: str = ...) -> None: ...
    def __rich_console__(self, console: Any, options: Any) -> Iterable[Any]: ...

class Splitter:
    name: str
    def get_tree_icon(self) -> str: ...
    def divide(self, children: Sequence[Any], region: Any) -> Iterable[Tuple[Any, Any]]: ...

class RowSplitter(Splitter):
    name: str
    def get_tree_icon(self) -> str: ...
    def divide(self, children: Sequence[Any], region: Any) -> Iterable[Tuple[Any, Any]]: ...

class ColumnSplitter(Splitter):
    name: str
    def get_tree_icon(self) -> str: ...
    def divide(self, children: Sequence[Any], region: Any) -> Iterable[Tuple[Any, Any]]: ...

class Layout:
    splitters: Dict[str, Any]
    def __init__(self, renderable: Any = ..., *, name: Optional[str] = ..., size: Optional[int] = ..., minimum_size: int = ..., ratio: int = ..., visible: bool = ...) -> None: ...
    def __rich_repr__(self) -> Iterable[Any]: ...
    @property
    def renderable(self) -> Any: ...
    @property
    def children(self) -> List[Any]: ...
    @property
    def map(self) -> Dict[Any, Any]: ...
    def get(self, name: str) -> Optional['Layout']: ...
    def __getitem__(self, name: str) -> Layout: ...
    @property
    def tree(self) -> Any: ...
    def split(self, *layouts: Any, splitter: Union[str, Splitter] = ...) -> None: ...
    def add_split(self, *layouts: Any) -> None: ...
    def split_row(self, *layouts: Any) -> None: ...
    def split_column(self, *layouts: Any) -> None: ...
    def unsplit(self) -> None: ...
    def update(self, renderable: Any) -> None: ...
    def refresh_screen(self, console: Any, layout_name: str) -> None: ...
    def render(self, console: Any, options: Any) -> Dict[Any, LayoutRender]: ...
    def __rich_console__(self, console: Any, options: Any) -> Iterable[Any]: ...
