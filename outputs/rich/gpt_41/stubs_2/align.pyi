from typing import Any, Callable, Iterable, Iterator, Optional, TypeVar, Union

AlignMethod = str
VerticalAlignMethod = str

class Align:
    def __init__(
        self,
        renderable: Any,
        align: AlignMethod = ...,
        style: Optional[Union[str, Any]] = ...,
        *,
        vertical: Optional[VerticalAlignMethod] = ...,
        pad: bool = ...,
        width: Optional[int] = ...,
        height: Optional[int] = ...,
    ) -> None: ...
    def __repr__(self) -> str: ...
    @classmethod
    def left(cls, renderable: Any, style: Optional[Union[str, Any]] = ..., *, vertical: Optional[VerticalAlignMethod] = ..., pad: bool = ..., width: Optional[int] = ..., height: Optional[int] = ...) -> "Align": ...
    @classmethod
    def center(cls, renderable: Any, style: Optional[Union[str, Any]] = ..., *, vertical: Optional[VerticalAlignMethod] = ..., pad: bool = ..., width: Optional[int] = ..., height: Optional[int] = ...) -> "Align": ...
    @classmethod
    def right(cls, renderable: Any, style: Optional[Union[str, Any]] = ..., *, vertical: Optional[VerticalAlignMethod] = ..., pad: bool = ..., width: Optional[int] = ..., height: Optional[int] = ...) -> "Align": ...
    def __rich_console__(self, console: Any, options: Any) -> Iterable[Any]: ...
    def __rich_measure__(self, console: Any, options: Any) -> Any: ...

class VerticalCenter:
    def __init__(self, renderable: Any, style: Optional[Union[str, Any]] = ...) -> None: ...
    def __repr__(self) -> str: ...
    def __rich_console__(self, console: Any, options: Any) -> Iterable[Any]: ...
    def __rich_measure__(self, console: Any, options: Any) -> Any: ...