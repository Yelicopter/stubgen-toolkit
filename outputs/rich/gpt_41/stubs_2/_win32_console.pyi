from typing import Any, IO, NamedTuple, Type

class LegacyWindowsError(Exception): ...

class WindowsCoordinates(NamedTuple):
    row: int
    col: int

    @classmethod
    def from_param(cls, value: Any) -> Any: ...

class CONSOLE_SCREEN_BUFFER_INFO: ...
class CONSOLE_CURSOR_INFO: ...

def GetStdHandle(handle: int = ...) -> Any: ...
def GetConsoleMode(std_handle: Any) -> int: ...
def FillConsoleOutputCharacter(std_handle: Any, char: str, length: int, start: Any) -> int: ...
def FillConsoleOutputAttribute(std_handle: Any, attributes: int, length: int, start: Any) -> int: ...
def SetConsoleTextAttribute(std_handle: Any, attributes: int) -> bool: ...
def GetConsoleScreenBufferInfo(std_handle: Any) -> Any: ...
def SetConsoleCursorPosition(std_handle: Any, coords: Any) -> bool: ...
def GetConsoleCursorInfo(std_handle: Any, cursor_info: Any) -> bool: ...
def SetConsoleCursorInfo(std_handle: Any, cursor_info: Any) -> bool: ...
def SetConsoleTitle(title: str) -> bool: ...

class LegacyWindowsTerm:
    BRIGHT_BIT: int
    ANSI_TO_WINDOWS: list[int]

    def __init__(self, file: IO[str]) -> None: ...
    @property
    def cursor_position(self) -> WindowsCoordinates: ...
    @property
    def screen_size(self) -> WindowsCoordinates: ...
    def write_text(self, text: str) -> None: ...
    def write_styled(self, text: str, style: Any) -> None: ...
    def move_cursor_to(self, new_position: WindowsCoordinates) -> None: ...
    def erase_line(self) -> None: ...
    def erase_end_of_line(self) -> None: ...
    def erase_start_of_line(self) -> None: ...
    def move_cursor_up(self) -> None: ...
    def move_cursor_down(self) -> None: ...
    def move_cursor_forward(self) -> None: ...
    def move_cursor_to_column(self, column: int) -> None: ...
    def move_cursor_backward(self) -> None: ...
    def hide_cursor(self) -> None: ...
    def show_cursor(self) -> None: ...
    def set_title(self, title: str) -> None: ...
    def _get_cursor_size(self) -> int: ...