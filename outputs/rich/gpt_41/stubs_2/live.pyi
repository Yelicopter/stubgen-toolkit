from typing import Any, Callable, IO, List, Optional, TextIO, Type

class _RefreshThread:
    def __init__(self, live: Any, refresh_per_second: float) -> None: ...
    def stop(self) -> None: ...
    def run(self) -> None: ...

class Live:
    def __init__(
        self,
        renderable: Any = ...,
        *,
        console: Optional[Any] = ...,
        screen: bool = ...,
        auto_refresh: bool = ...,
        refresh_per_second: float = ...,
        transient: bool = ...,
        redirect_stdout: bool = ...,
        redirect_stderr: bool = ...,
        vertical_overflow: str = ...,
        get_renderable: Optional[Callable[[], Any]] = ...,
    ) -> None: ...
    @property
    def is_started(self) -> bool: ...
    def get_renderable(self) -> Any: ...
    def start(self, refresh: bool = False) -> None: ...
    def stop(self) -> None: ...
    def __enter__(self) -> "Live": ...
    def __exit__(self, exc_type: Any, exc_val: Any, exc_tb: Any) -> None: ...
    def _enable_redirect_io(self) -> None: ...
    def _disable_redirect_io(self) -> None: ...
    @property
    def renderable(self) -> Any: ...
    def update(self, renderable: Any, *, refresh: bool = False) -> None: ...
    def refresh(self) -> None: ...
    def process_renderables(self, renderables: List[Any]) -> List[Any]: ...