import abc
from ..exceptions import APIKeyNotFoundError as APIKeyNotFoundError, MethodNotImplementedError as MethodNotImplementedError, NoCodeFoundError as NoCodeFoundError
from _typeshed import Incomplete
from abc import abstractmethod
from pandasai.agent.state import AgentState as AgentState
from pandasai.core.prompts.base import BasePrompt as BasePrompt
from pandasai.core.prompts.generate_system_message import GenerateSystemMessagePrompt as GenerateSystemMessagePrompt
from pandasai.helpers.memory import Memory as Memory
from typing import Any, Optional

class LLM(metaclass=abc.ABCMeta):
    last_prompt: Optional[str]
    api_key: Incomplete
    def __init__(self, api_key: Optional[str] = ..., **kwargs: Any) -> None: ...
    def is_pandasai_llm(self) -> bool: ...
    @property
    def type(self) -> str: ...
    def prepend_system_prompt(self, prompt: BasePrompt, memory: Memory): ...
    def get_system_prompt(self, memory: Memory) -> Any: ...
    def get_messages(self, memory: Memory) -> Any: ...
    @abstractmethod
    def call(self, instruction: BasePrompt, context: AgentState = ...) -> str: ...
    def generate_code(self, instruction: BasePrompt, context: AgentState) -> str: ...
