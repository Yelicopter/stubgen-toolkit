from typing import Union

class Memory:
    agent_description: str
    def __init__(self, memory_size: int = ..., agent_description: Union[str, None] = ...) -> None: ...
    def add(self, message: str, is_user: bool): ...
    def count(self) -> int: ...
    def all(self) -> list: ...
    def last(self) -> dict: ...
    def get_messages(self, limit: int = ...) -> list: ...
    def get_conversation(self, limit: int = ...) -> str: ...
    def get_previous_conversation(self) -> str: ...
    def get_last_message(self) -> str: ...
    def to_json(self): ...
    def to_openai_messages(self): ...
    def clear(self) -> None: ...
    @property
    def size(self): ...
