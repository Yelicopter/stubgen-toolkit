from typing import Dict, List, Optional

class SQLParser:
    @staticmethod
    def replace_table_and_column_names(
        query: str, table_mapping: Dict[str, str]
    ) -> str: ...
    @staticmethod
    def transpile_sql_dialect(
        query: str, to_dialect: str, from_dialect: Optional[str] = ...
    ) -> str: ...
    @staticmethod
    def extract_table_names(sql_query: str, dialect: str = ...) -> List[str]: ...