from __future__ import annotations

from abc import abstractmethod
from typing import TYPE_CHECKING, Any, Optional, Union

from pandasai.core.prompts.base import BasePrompt
from pandasai.helpers.memory import Memory

if TYPE_CHECKING:
    from pandasai.agent.state import AgentState

class LLM:
    last_prompt: Optional[str]
    api_key: Optional[str]
    def __init__(self, api_key: Optional[str] = ..., **kwargs: Any) -> None: ...
    def is_pandasai_llm(self) -> bool: ...
    @property
    def type(self) -> str: ...
    def _polish_code(self, code: str) -> str: ...
    def _is_python_code(self, string: str) -> bool: ...
    def _extract_code(self, response: str, separator: str = ...) -> str: ...
    def prepend_system_prompt(
        self, prompt: BasePrompt, memory: Memory
    ) -> Union[BasePrompt, str]: ...
    def get_system_prompt(self, memory: Memory) -> str: ...
    def get_messages(self, memory: Memory) -> str: ...
    @abstractmethod
    def call(self, instruction: BasePrompt, context: Optional[AgentState] = ...) -> str: ...
    def generate_code(self, instruction: BasePrompt, context: AgentState) -> str: ...