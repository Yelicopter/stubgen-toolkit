import uuid
from functools import cached_property
from typing import Any, Dict, List, Optional, Union

import pandas as pd

from pandasai.agent import Agent
from pandasai.config import Config
from pandasai.dataframe.base import DataFrame
from pandasai.helpers.logger import Logger

class SmartDataframe:
    _table_name: Optional[str]
    _table_description: Optional[str]
    _custom_head: Optional[str]
    _original_import: Any
    dataframe: DataFrame
    _agent: Agent
    def __init__(
        self,
        df: Union[pd.DataFrame, Any],
        name: Optional[str] = ...,
        description: Optional[str] = ...,
        custom_head: Optional[pd.DataFrame] = ...,
        config: Optional[Union[Config, Dict[str, Any]]] = ...,
    ) -> None: ...
    def load_df(
        self,
        df: Union[pd.DataFrame, Any],
        name: Optional[str],
        description: Optional[str],
        custom_head: Optional[pd.DataFrame],
    ) -> DataFrame: ...
    def chat(self, query: str, output_type: Optional[str] = ...) -> Any: ...
    @cached_property
    def head_df(self) -> pd.DataFrame: ...
    @cached_property
    def head_csv(self) -> str: ...
    @property
    def last_prompt(self) -> str: ...
    @property
    def last_prompt_id(self) -> Optional[uuid.UUID]: ...
    @property
    def last_code_generated(self) -> Optional[str]: ...
    @property
    def last_code_executed(self) -> Optional[str]: ...
    def original_import(self) -> Any: ...
    @property
    def logger(self) -> Logger: ...
    @logger.setter
    def logger(self, logger: Logger) -> None: ...
    @property
    def logs(self) -> List[Dict[str, Any]]: ...
    @property
    def verbose(self) -> bool: ...
    @verbose.setter
    def verbose(self, verbose: bool) -> None: ...
    @property
    def save_logs(self) -> bool: ...
    @save_logs.setter
    def save_logs(self, save_logs: bool) -> None: ...
    @property
    def save_charts(self) -> bool: ...
    @save_charts.setter
    def save_charts(self, save_charts: bool) -> None: ...
    @property
    def save_charts_path(self) -> str: ...
    @save_charts_path.setter
    def save_charts_path(self, save_charts_path: str) -> None: ...
    @property
    def table_name(self) -> Optional[str]: ...
    @property
    def table_description(self) -> Optional[str]: ...
    @property
    def custom_head(self) -> Optional[pd.DataFrame]: ...
    def __len__(self) -> int: ...
    def __eq__(self, other: Any) -> bool: ...
    def __getattr__(self, name: str) -> Any: ...
    def __getitem__(self, key: Any) -> Any: ...
    def __setitem__(self, key: Any, value: Any) -> None: ...

def load_smartdataframes(
    dfs: List[Union[pd.DataFrame, Any]], config: Optional[Union[Config, Dict[str, Any]]]
) -> List[SmartDataframe]: ...