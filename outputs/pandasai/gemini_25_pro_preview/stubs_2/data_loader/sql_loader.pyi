from typing import Any, Callable, List, Optional

import pandas as pd

from pandasai.dataframe.virtual_dataframe import VirtualDataFrame
from pandasai.query_builders.sql_query_builder import SqlQueryBuilder

from .loader import DatasetLoader
from .semantic_layer_schema import SemanticLayerSchema

class SQLDatasetLoader(DatasetLoader):
    _query_builder: SqlQueryBuilder
    def __init__(self, schema: SemanticLayerSchema, dataset_path: str) -> None: ...
    @property
    def query_builder(self) -> SqlQueryBuilder: ...
    def load(self) -> VirtualDataFrame: ...
    def execute_query(
        self, query: str, params: Optional[List[Any]] = ...
    ) -> pd.DataFrame: ...
    @staticmethod
    def _get_loader_function(source_type: str) -> Callable[..., pd.DataFrame]: ...
    def load_head(self) -> pd.DataFrame: ...
    def get_row_count(self) -> int: ...