from __future__ import annotations

from typing import Any, Dict, List, Optional, Union

import pandas as pd

from pandasai.config import Config
from pandasai.core.response.error import ErrorResponse
from pandasai.core.user_query import UserQuery
from pandasai.dataframe.base import DataFrame
from pandasai.dataframe.virtual_dataframe import VirtualDataFrame
from pandasai.sandbox.sandbox import Sandbox
from pandasai.vectorstores.vectorstore import VectorStore

from .state import AgentState

class Agent:
    description: Optional[str]
    _state: AgentState
    _code_generator: Any
    _response_parser: Any
    _sandbox: Optional[Sandbox]
    def __init__(
        self,
        dfs: Union[Union[DataFrame, VirtualDataFrame], List[Union[DataFrame, VirtualDataFrame]]],
        config: Optional[Union[Config, Dict[str, Any]]] = ...,
        memory_size: int = ...,
        vectorstore: Optional[VectorStore] = ...,
        description: Optional[str] = ...,
        sandbox: Optional[Sandbox] = ...,
    ) -> None: ...
    def chat(self, query: str, output_type: Optional[str] = ...) -> Any: ...
    def follow_up(self, query: str, output_type: Optional[str] = ...) -> Any: ...
    def generate_code(self, query: Union[str, UserQuery]) -> str: ...
    def execute_code(self, code: str) -> Any: ...
    def _execute_sql_query(self, query: str) -> pd.DataFrame: ...
    def generate_code_with_retries(self, query: str) -> str: ...
    def execute_with_retries(self, code: str) -> Any: ...
    def train(
        self,
        queries: Optional[List[str]] = ...,
        codes: Optional[List[str]] = ...,
        docs: Optional[List[str]] = ...,
    ) -> None: ...
    def clear_memory(self) -> None: ...
    def add_message(self, message: str, is_user: bool = ...) -> None: ...
    def start_new_conversation(self) -> None: ...
    def _process_query(self, query: str, output_type: Optional[str] = ...) -> Any: ...
    def _regenerate_code_after_error(self, code: str, error: Exception) -> str: ...
    def _handle_exception(self, code: str) -> ErrorResponse: ...
    @property
    def last_generated_code(self) -> Optional[str]: ...
    @property
    def last_code_executed(self) -> Optional[str]: ...
    @property
    def last_prompt_used(self) -> Optional[str]: ...