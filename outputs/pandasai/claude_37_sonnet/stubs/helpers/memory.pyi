from typing import Any, Dict, List, Optional, Union

class Memory:
    _messages: List[Dict[str, Any]]
    _memory_size: int
    agent_description: Optional[str]
    
    def __init__(
        self, memory_size: int = 1, agent_description: Optional[str] = None
    ) -> None: ...
    
    def add(self, message: str, is_user: bool) -> None: ...
    
    def count(self) -> int: ...
    
    def all(self) -> List[Dict[str, Any]]: ...
    
    def last(self) -> Dict[str, Any]: ...
    
    def _truncate(self, message: Union[str, Any], max_length: int = 100) -> str: ...
    
    def get_messages(self, limit: int = None) -> List[str]: ...
    
    def get_conversation(self, limit: int = None) -> str: ...
    
    def get_previous_conversation(self) -> str: ...
    
    def get_last_message(self) -> str: ...
    
    def to_json(self) -> List[Dict[str, Any]]: ...
    
    def to_openai_messages(self) -> List[Dict[str, str]]: ...
    
    def clear(self) -> None: ...
    
    @property
    def size(self) -> int: ...