import ast
from typing import Any, Dict, List

class Sandbox:
    _started: bool = False
    
    def start(self) -> None: ...
    
    def stop(self) -> None: ...
    
    def execute(self, code: str, environment: Dict) -> Any: ...
    
    def _exec_code(self, code: str, environment: Dict) -> Any: ...
    
    def transfer_file(self, csv_data, filename="file.csv") -> None: ...
    
    def _extract_sql_queries_from_code(self, code) -> List[str]: ...
    
    def _compile_code(self, code: str) -> str: ...