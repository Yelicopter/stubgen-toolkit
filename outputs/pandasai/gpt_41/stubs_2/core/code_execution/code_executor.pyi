from typing import Any

class CodeExecutor:
    def __init__(self, config: Any) -> None: ...
    def add_to_env(self, key: str, value: Any) -> None: ...
    def execute(self, code: str) -> dict: ...
    def execute_and_return_result(self, code: str) -> Any: ...
    @property
    def environment(self) -> dict: ...