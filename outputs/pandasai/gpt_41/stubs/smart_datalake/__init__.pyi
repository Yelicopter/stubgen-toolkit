from typing import List, Optional, Any

class SmartDatalake:
    def __init__(
        self,
        dfs: List[Any],
        config: Optional[Any] = ...,
    ): ...
    def load_dfs(self, dfs: List[Any]) -> List[Any]: ...
    def chat(self, query: str, output_type: Optional[str] = ...) -> Any: ...
    def clear_memory(self) -> None: ...
    @property
    def last_prompt(self) -> Any: ...
    @property
    def last_prompt_id(self) -> Any: ...
    @property
    def logs(self) -> Any: ...
    @property
    def logger(self) -> Any: ...
    @logger.setter
    def logger(self, logger: Any) -> None: ...
    @property
    def config(self) -> Any: ...
    @property
    def verbose(self) -> Any: ...
    @verbose.setter
    def verbose(self, verbose: Any) -> None: ...
    @property
    def save_logs(self) -> Any: ...
    @save_logs.setter
    def save_logs(self, save_logs: Any) -> None: ...
    @property
    def custom_prompts(self) -> Any: ...
    @custom_prompts.setter
    def custom_prompts(self, custom_prompts: Any) -> None: ...
    @property
    def save_charts(self) -> Any: ...
    @save_charts.setter
    def save_charts(self, save_charts: Any) -> None: ...
    @property
    def save_charts_path(self) -> Any: ...
    @save_charts_path.setter
    def save_charts_path(self, save_charts_path: Any) -> None: ...
    @property
    def last_code_generated(self) -> Any: ...
    @property
    def last_code_executed(self) -> Any: ...
    @property
    def last_result(self) -> Any: ...
    @property
    def last_error(self) -> Any: ...
    @property
    def dfs(self) -> Any: ...
    @property
    def memory(self) -> Any: ...