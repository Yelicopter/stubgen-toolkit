from abc import ABC, abstractmethod
from typing import Iterable, List, Optional, Any

class VectorStore(ABC):
    @abstractmethod
    def add_question_answer(
        self,
        queries: Any,
        codes: Any,
        ids: Optional[Iterable[Any]] = ...,
        metadatas: Optional[List[Any]] = ...,
    ) -> Any: ...
    @abstractmethod
    def add_docs(
        self,
        docs: Any,
        ids: Optional[Iterable[Any]] = ...,
        metadatas: Optional[List[Any]] = ...,
    ) -> Any: ...
    def update_question_answer(
        self,
        ids: Any,
        queries: Any,
        codes: Any,
        metadatas: Optional[List[Any]] = ...,
    ) -> Any: ...
    def update_docs(
        self,
        ids: Any,
        docs: Any,
        metadatas: Optional[List[Any]] = ...,
    ) -> Any: ...
    def delete_question_and_answers(
        self, ids: Optional[List[Any]] = ...
    ) -> Optional[bool]: ...
    def delete_docs(self, ids: Optional[List[Any]] = ...) -> Optional[bool]: ...
    def delete_collection(self, collection_name: str) -> Optional[bool]: ...
    def get_relevant_question_answers(self, question: Any, k: int = ...) -> Any: ...
    def get_relevant_docs(self, question: Any, k: int = ...) -> Any: ...
    def get_relevant_question_answers_by_id(self, ids: Any) -> Any: ...
    def get_relevant_docs_by_id(self, ids: Any) -> Any: ...
    @abstractmethod
    def get_relevant_qa_documents(self, question: Any, k: int = ...) -> Any: ...
    @abstractmethod
    def get_relevant_docs_documents(self, question: Any, k: int = ...) -> Any: ...
    def _format_qa(self, query: Any, code: Any) -> str: ...
```