from typing import List, Any

class BaseQueryBuilder:
    schema: Any
    transformation_manager: Any

    def __init__(self, schema: Any): ...
    def validate_query_builder(self) -> None: ...
    def build_query(self) -> str: ...
    def get_head_query(self, n: int = ...) -> str: ...
    def get_row_count(self) -> str: ...
    def _get_columns(self) -> List[str]: ...
    def _get_table_expression(self) -> str: ...
    def _check_distinct(self) -> bool: ...
    @staticmethod
    def check_compatible_sources(sources: List[Any]) -> bool: ...