import argparse
from typing import Any, Optional

__all__: tuple[str, ...]

class Report:
    def __init__(self, application: Any) -> None: ...
    @property
    def total_errors(self) -> int: ...
    def get_statistics(self, violation: str) -> list[str]: ...

class StyleGuide:
    def __init__(self, application: Any) -> None: ...
    @property
    def options(self) -> argparse.Namespace: ...
    @property
    def paths(self) -> list[str]: ...
    def check_files(self, paths: Optional[list[str]] = ...) -> Report: ...
    def excluded(self, filename: str, parent: Optional[str] = ...) -> bool: ...
    def init_report(
        self,
        reporter: Optional[type] = ...,
    ) -> None: ...
    def input_file(
        self,
        filename: str,
        lines: Any = ...,
        expected: Any = ...,
        line_offset: int = ...,
    ) -> Report: ...

def get_style_guide(**kwargs: Any) -> StyleGuide: ...