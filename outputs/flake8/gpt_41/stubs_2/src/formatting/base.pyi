import argparse
from typing import IO, Any
from flake8.statistics import Statistics
from flake8.violation import Violation

class BaseFormatter:
    options: Any
    filename: str
    output_fd: IO[str] | None
    newline: str
    color: bool
    def __init__(self, options: Any) -> None: ...
    def after_init(self) -> None: ...
    def beginning(self, filename: str) -> None: ...
    def finished(self, filename: str) -> None: ...
    def start(self) -> None: ...
    def handle(self, error: Violation) -> None: ...
    def format(self, error: Violation) -> str: ...
    def show_statistics(self, statistics: Statistics) -> None: ...
    def show_benchmarks(self, benchmarks: list[tuple[str, int | float]]) -> None: ...
    def show_source(self, error: Violation) -> str: ...
    def _write(self, output: str) -> None: ...
    def write(self, line: str, source: str) -> None: ...
    def stop(self) -> None: ...