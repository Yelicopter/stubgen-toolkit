from flake8.formatting.base import BaseFormatter
from flake8.violation import Violation
from typing import Optional

COLORS: dict[str, str]
COLORS_OFF: dict[str, str]

class SimpleFormatter(BaseFormatter):
    error_format: str
    def format(self, error: Violation) -> str: ...

class Default(SimpleFormatter):
    error_format: str
    def after_init(self) -> None: ...

class Pylint(SimpleFormatter):
    error_format: str

class FilenameOnly(SimpleFormatter):
    error_format: str
    filenames_already_printed: set[str]
    def after_init(self) -> None: ...
    def show_source(self, error: Violation) -> str: ...
    def format(self, error: Violation) -> str: ...

class Nothing(BaseFormatter):
    def format(self, error: Violation) -> str: ...
    def show_source(self, error: Violation) -> str: ...
