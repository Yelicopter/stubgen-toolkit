import argparse
from collections.abc import Sequence, Generator
from typing import Any, Optional

Results = list[tuple[str, int, int, str, Optional[str]]]

class Manager:
    style_guide: Any
    options: Any
    plugins: Any
    jobs: int
    statistics: dict[str, int]
    exclude: tuple[Any, ...]
    argv: Any
    results: list[Any]
    filenames: tuple[str, ...]
    def __init__(
        self,
        style_guide: Any,
        plugins: Any,
        argv: Any,
    ) -> None: ...
    def _process_statistics(self) -> None: ...
    def _job_count(self) -> int: ...
    def _handle_results(self, filename: str, results: Any) -> int: ...
    def report(self) -> tuple[int, int]: ...
    def run_parallel(self) -> None: ...
    def run_serial(self) -> None: ...
    def run(self) -> None: ...
    def start(self) -> None: ...
    def stop(self) -> None: ...

class FileChecker:
    options: Any
    filename: str
    plugins: Any
    results: list[Any]
    statistics: dict[str, int]
    processor: Any
    display_name: str
    should_process: bool
    def __init__(
        self,
        *,
        filename: str,
        plugins: Any,
        options: Any,
    ) -> None: ...
    def __repr__(self) -> str: ...
    def _make_processor(self) -> Any: ...
    def report(
        self,
        error_code: Optional[str],
        line_number: int,
        column: int,
        text: str,
    ) -> str: ...
    def run_check(self, plugin: Any, **arguments: Any) -> Any: ...
    @staticmethod
    def _extract_syntax_information(exception: Exception) -> tuple[int, int]: ...
    def run_ast_checks(self) -> None: ...
    def run_logical_checks(self) -> None: ...
    def run_physical_checks(self, physical_line: str) -> None: ...
    def process_tokens(self) -> None: ...
    def run_checks(self) -> tuple[str, list[Any], dict[str, int]]: ...
    def handle_newline(self, token_type: int) -> None: ...
    def check_physical_eol(
        self, token: Any, prev_physical: str
    ) -> None: ...

def _try_initialize_processpool(
    job_count: int,
    argv: Any,
) -> Optional[Any]: ...

def find_offset(
    offset: Any, mapping: Sequence[tuple[int, tuple[int, int]]]
) -> tuple[int, int]: ...

SERIAL_RETRY_ERRNOS: set[int]