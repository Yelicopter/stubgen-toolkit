import logging
from argparse import Namespace
from typing import Any, List, Optional

LOG: logging.Logger

class Report:
    def __init__(self, application: Any) -> None: ...
    @property
    def total_errors(self) -> int: ...
    def get_statistics(self, violation: str) -> List[str]: ...

class StyleGuide:
    def __init__(self, application: Any) -> None: ...
    @property
    def options(self) -> Namespace: ...
    @property
    def paths(self) -> List[str]: ...
    def check_files(self, paths: Optional[List[str]] = ...) -> Report: ...
    def excluded(self, filename: str, parent: Optional[str] = ...) -> bool: ...
    def init_report(self, reporter: Any = ...) -> None: ...
    def input_file(self, filename: str, lines: Any = ..., expected: Any = ..., line_offset: Any = ...) -> Report: ...

def get_style_guide(**kwargs: Any) -> StyleGuide: ...
