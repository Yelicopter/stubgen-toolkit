from argparse import ArgumentParser
from collections.abc import Sequence as Sequence
from typing import Any, Dict, List, Optional, Tuple

class Option:
    def __init__(self, short_option_name: Optional[str] = ..., long_option_name: Optional[str] = ..., action: Any = ..., default: Any = ..., type: Any = ..., dest: Optional[str] = ..., nargs: Any = ..., const: Any = ..., choices: Any = ..., help: Optional[str] = ..., metavar: Optional[str] = ..., required: bool = ..., parse_from_config: bool = ..., comma_separated_list: bool = ..., normalize_paths: bool = ...) -> None: ...
    @property
    def filtered_option_kwargs(self) -> Dict[str, Any]: ...
    def normalize(self, value: Any, *normalize_args: Any) -> Any: ...
    def to_argparse(self) -> Tuple[List[str], Dict[str, Any]]: ...

class OptionManager:
    def __init__(self, *, version: str, plugin_versions: str, parents: List[ArgumentParser], formatter_names: List[str]) -> None: ...
    def register_plugins(self, plugins: Any) -> None: ...
    def add_option(self, *args: Any, **kwargs: Any) -> None: ...
    def extend_default_ignore(self, error_codes: List[str]) -> None: ...
    def extend_default_select(self, error_codes: List[str]) -> None: ...
    def parse_args(self, args: Optional[List[str]] = ..., values: Any = ...) -> Any: ...
