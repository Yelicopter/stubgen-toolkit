import enum
from collections.abc import Generator
from typing import Any, List, Optional

class Selected(enum.Enum): ...
class Ignored(enum.Enum): ...
class Decision(enum.Enum): ...

class DecisionEngine:
    def __init__(self, options: Any) -> None: ...
    def was_selected(self, code: str) -> Any: ...
    def was_ignored(self, code: str) -> Any: ...
    def make_decision(self, code: str) -> Decision: ...
    def decision_for(self, code: str) -> Decision: ...

class StyleGuideManager:
    def __init__(self, options: Any, formatter: Any, decider: Any = ...) -> None: ...
    def populate_style_guides_with(self, options: Any) -> Generator[Any, None, None]: ...
    def processing_file(self, filename: str) -> Any: ...
    def handle_error(self, code: str, filename: str, line_number: int, column_number: int, text: str, physical_line: Optional[str] = ...) -> int: ...

class StyleGuide:
    def __init__(self, options: Any, formatter: Any, stats: Any, filename: Optional[str] = ..., decider: Any = ...) -> None: ...
    def copy(self, filename: Optional[str] = ..., extend_ignore_with: Optional[List[str]] = ...) -> Any: ...
    def processing_file(self, filename: str) -> Any: ...
    def applies_to(self, filename: str) -> bool: ...
    def should_report_error(self, code: str) -> Decision: ...
    def handle_error(self, code: str, filename: str, line_number: int, column_number: int, text: str, physical_line: Optional[str] = ...) -> int: ...
