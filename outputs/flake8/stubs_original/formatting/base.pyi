from typing import Any, List, Tuple

class BaseFormatter:
    def __init__(self, options: Any) -> None: ...
    def after_init(self) -> None: ...
    def beginning(self, filename: str) -> None: ...
    def finished(self, filename: str) -> None: ...
    def start(self) -> None: ...
    def handle(self, error: Any) -> None: ...
    def format(self, error: Any) -> str: ...
    def show_statistics(self, statistics: Any) -> None: ...
    def show_benchmarks(self, benchmarks: List[Tuple[str, Any]]) -> None: ...
    def show_source(self, error: Any) -> str: ...
    def write(self, line: str, source: str) -> None: ...
    def stop(self) -> None: ...
