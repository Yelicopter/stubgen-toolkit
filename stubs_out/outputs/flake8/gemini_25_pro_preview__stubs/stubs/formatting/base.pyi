import argparse
from flake8.statistics import Statistics as Statistics
from flake8.violation import Violation as Violation
from typing import IO, Optional

class BaseFormatter:
    options: argparse.Namespace
    filename: Optional[str]
    output_fd: Optional[IO[str]]
    newline: str
    color: bool
    def __init__(self, options: argparse.Namespace) -> None: ...
    def after_init(self) -> None: ...
    def beginning(self, filename: str) -> None: ...
    def finished(self, filename: str) -> None: ...
    def start(self) -> None: ...
    def handle(self, error: Violation) -> None: ...
    def format(self, error: Violation) -> Optional[str]: ...
    def show_statistics(self, statistics: Statistics) -> None: ...
    def show_benchmarks(self, benchmarks: list[tuple[str, int | float]]) -> None: ...
    def show_source(self, error: Violation) -> Optional[str]: ...
    def write(self, line: Optional[str], source: Optional[str]) -> None: ...
    def stop(self) -> None: ...
