import argparse
import logging
import tokenize
from collections.abc import Sequence as Sequence
from flake8 import exceptions as exceptions, processor
from flake8.plugins.finder import Checkers as Checkers, LoadedPlugin as LoadedPlugin
from flake8.style_guide import StyleGuideManager as StyleGuideManager
from typing import Any, Optional

Results = list[tuple[str, int, int, str, Optional[str]]]
LOG: logging.Logger
SERIAL_RETRY_ERRNOS: set[int]

class Manager:
    style_guide: StyleGuideManager
    options: argparse.Namespace
    plugins: Checkers
    jobs: int
    statistics: dict[str, int]
    exclude: tuple[str, ...]
    argv: list[str] | None
    results: list[tuple[str, Results, dict[str, int]]]
    filenames: tuple[str, ...]
    def __init__(self, style_guide: StyleGuideManager, plugins: Checkers, argv: list[str] | None) -> None: ...
    def report(self) -> tuple[int, int]: ...
    def run_parallel(self) -> None: ...
    def run_serial(self) -> None: ...
    def run(self) -> None: ...
    def start(self) -> None: ...
    def stop(self) -> None: ...

class FileChecker:
    options: argparse.Namespace
    filename: str
    plugins: Checkers
    results: Results
    statistics: dict[str, int]
    processor: processor.FileProcessor | None
    display_name: str
    should_process: bool
    def __init__(self, *, filename: str, plugins: Checkers, options: argparse.Namespace) -> None: ...
    def report(self, error_code: Optional[str], line_number: int, column: int, text: str) -> str: ...
    def run_check(self, plugin: LoadedPlugin, **arguments: Any) -> Any: ...
    def run_ast_checks(self) -> None: ...
    def run_logical_checks(self) -> None: ...
    def run_physical_checks(self, physical_line: str) -> None: ...
    def process_tokens(self) -> None: ...
    def run_checks(self) -> tuple[str, Results, dict[str, int]]: ...
    def handle_newline(self, token_type: int) -> None: ...
    def check_physical_eol(self, token: tokenize.TokenInfo, prev_physical: str) -> None: ...

def find_offset(offset: int | tuple[int, int], mapping: list[tuple[int, tuple[int, int]]]) -> tuple[int, int]: ...
