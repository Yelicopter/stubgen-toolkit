import ast
import logging
import tokenize
from collections.abc import Generator
from typing import Any

LOG: logging.Logger
NEWLINE: frozenset[int]
SKIP_TOKENS: frozenset[int]

class FileProcessor:
    options: Any
    filename: str
    lines: list[str]
    blank_before: int
    blank_lines: int
    checker_state: dict[str, Any]
    hang_closing: bool
    indent_char: str | None
    indent_level: int
    indent_size: int
    line_number: int
    logical_line: str
    max_line_length: int
    max_doc_length: int
    multiline: bool
    previous_indent_level: int
    previous_logical: str
    previous_unindented_logical_line: str
    tokens: list[Any]
    total_lines: int
    verbose: int
    statistics: dict[str, int]
    noqa: bool
    def __init__(self, filename: str, options: Any, lines: list[str] | None = ...) -> None: ...
    @property
    def file_tokens(self) -> list[tokenize.TokenInfo]: ...
    def fstring_start(self, lineno: int) -> None: ...
    def tstring_start(self, lineno: int) -> None: ...
    def multiline_string(self, token: tokenize.TokenInfo) -> Generator[str, None, None]: ...
    def reset_blank_before(self) -> None: ...
    def delete_first_token(self) -> None: ...
    def visited_new_blank_line(self) -> None: ...
    def update_state(self, mapping: list[tuple[int, tuple[int, int]]]) -> None: ...
    def update_checker_state_for(self, plugin: Any) -> None: ...
    def next_logical_line(self) -> None: ...
    def build_logical_line_tokens(self) -> tuple[list[str], list[str], list[tuple[int, tuple[int, int]]]]: ...
    def build_ast(self) -> ast.AST: ...
    def build_logical_line(self) -> tuple[str, str, list[tuple[int, tuple[int, int]]]]: ...
    def keyword_arguments_for(self, parameters: dict[str, bool], arguments: dict[str, Any]) -> dict[str, Any]: ...
    def generate_tokens(self) -> Generator[tokenize.TokenInfo, None, None]: ...
    def noqa_line_for(self, line_number: int) -> str | None: ...
    def next_line(self) -> str: ...
    def read_lines(self) -> list[str]: ...
    def read_lines_from_filename(self) -> list[str]: ...
    def read_lines_from_stdin(self) -> list[str]: ...
    def should_ignore_file(self) -> bool: ...
    def strip_utf_bom(self) -> None: ...

def is_eol_token(token: tokenize.TokenInfo) -> bool: ...
def is_multiline_string(token: tokenize.TokenInfo) -> bool: ...
def token_is_newline(token: tokenize.TokenInfo) -> bool: ...
def count_parentheses(current_parentheses_count: int, token_text: str) -> int: ...
def expand_indent(line: str) -> int: ...
def mutate_string(text: str) -> str: ...
