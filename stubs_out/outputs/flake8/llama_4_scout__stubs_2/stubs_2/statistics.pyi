from collections.abc import Generator
from flake8.violation import Violation as Violation
from typing import NamedTuple, Optional

class Statistics:
    def __init__(self) -> None: ...
    def error_codes(self) -> list[str]: ...
    def record(self, error: Violation) -> None: ...
    def statistics_for(self, prefix: str, filename: Optional[str] = ...) -> Generator[tuple[str, int], None, None]: ...

class Key(NamedTuple):
    filename: str
    code: str
    @classmethod
    def create_from(cls, error: Violation) -> Key: ...
    def matches(self, prefix: str, filename: Optional[str]) -> bool: ...

class Statistic:
    def __init__(self, error_code: str, filename: str, message: str, count: int) -> None: ...
    @classmethod
    def create_from(cls, error: Violation) -> Statistic: ...
    def increment(self) -> None: ...
