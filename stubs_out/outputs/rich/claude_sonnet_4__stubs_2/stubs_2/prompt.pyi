from .console import Console as Console
from .text import Text as Text, TextType as TextType
from typing import Any, List, Optional

class PromptError(Exception): ...
class InvalidResponse(PromptError): ...

class PromptBase:
    def __init__(self, prompt: TextType = ..., *, console: Optional[Console] = ..., password: bool = ..., choices: Optional[List[str]] = ..., show_default: bool = ..., show_choices: bool = ...) -> None: ...
    def __call__(self, *, stream: Optional[Any] = ...) -> Any: ...

class Prompt(PromptBase):
    response_type: type
    def process_response(self, value: str) -> Any: ...

class IntPrompt(Prompt):
    response_type: type
    def process_response(self, value: str) -> int: ...

class FloatPrompt(Prompt):
    response_type: type
    def process_response(self, value: str) -> float: ...

class Confirm(PromptBase):
    response_type: type
    def __init__(self, prompt: TextType = ..., *, console: Optional[Console] = ..., password: bool = ..., choices: Optional[List[str]] = ..., show_default: bool = ..., show_choices: bool = ..., default: bool = ...) -> None: ...
    def process_response(self, value: str) -> bool: ...
