from .console import Console as Console, ConsoleOptions as ConsoleOptions, RenderResult as RenderResult
from .jupyter import JupyterMixin as JupyterMixin
from .measure import Measurement as Measurement
from .segment import Segment as Segment
from .style import StyleType as StyleType
from .text import Text as Text, TextType as TextType
from typing import Any, Dict, List, Optional, Union

class Tree(JupyterMixin):
    def __init__(self, label: TextType, *, style: StyleType = ..., guide_style: StyleType = ..., expanded: bool = ..., highlight: bool = ...) -> None: ...
    @classmethod
    def from_data(cls, data: Union[Dict[Any, Any], List[Any]], *, name: str = ..., style: StyleType = ..., guide_style: StyleType = ..., expanded: bool = ..., highlight: bool = ...) -> Tree: ...
    def add(self, label: TextType, *, style: Optional[StyleType] = ..., guide_style: Optional[StyleType] = ..., expanded: bool = ..., highlight: Optional[bool] = ...) -> Tree: ...
    def add_tree(self, tree: Tree, *, style: Optional[StyleType] = ..., guide_style: Optional[StyleType] = ..., expanded: bool = ..., highlight: Optional[bool] = ...) -> Tree: ...
    def __rich_console__(self, console: Console, options: ConsoleOptions) -> RenderResult: ...
    def __rich_measure__(self, console: Console, options: ConsoleOptions) -> Measurement: ...
