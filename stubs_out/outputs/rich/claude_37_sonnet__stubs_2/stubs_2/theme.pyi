from .default_styles import DEFAULT_STYLES as DEFAULT_STYLES
from .style import Style as Style, StyleType as StyleType
from typing import Callable, Dict, IO, Mapping, Optional

class Theme:
    styles: Dict[str, Style]
    def __init__(self, styles: Optional[Mapping[str, StyleType]] = ..., inherit: bool = ...) -> None: ...
    @property
    def config(self) -> str: ...
    @classmethod
    def from_file(cls, config_file: IO[str], source: Optional[str] = ..., inherit: bool = ...) -> Theme: ...
    @classmethod
    def read(cls, path: str, inherit: bool = ..., encoding: Optional[str] = ...) -> Theme: ...

class ThemeStackError(Exception): ...

class ThemeStack:
    def __init__(self, theme: Theme) -> None: ...
    get: Callable[[str, Optional[Style]], Style]
    def push_theme(self, theme: Theme, inherit: bool = ...) -> None: ...
    def pop_theme(self) -> None: ...
