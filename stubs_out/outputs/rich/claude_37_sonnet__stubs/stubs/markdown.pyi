class MarkdownContext:
    def __init__(self, console: Console, options: ConsoleOptions, style: Style, inline_code_lexer: str | None = ..., inline_code_theme: str = ...) -> None: ...
    @property
    def current_style(self) -> Style: ...
    def on_text(self, text: str, node_type: str) -> None: ...
    def enter_style(self, style_name: str | Style) -> Style: ...
    def leave_style(self) -> Style: ...

class Markdown(JupyterMixin):
    elements: ClassVar[dict[str, type[MarkdownElement]]]
    inlines: set
    def __init__(self, markup: str, code_theme: str = ..., justify: JustifyMethod | None = ..., style: str | Style = ..., hyperlinks: bool = ..., inline_code_lexer: str | None = ..., inline_code_theme: str | None = ...) -> None: ...
    def __rich_console__(self, console: Console, options: ConsoleOptions) -> RenderResult: ...
