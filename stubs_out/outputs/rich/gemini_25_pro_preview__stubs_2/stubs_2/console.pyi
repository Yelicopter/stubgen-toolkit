JUPYTER_DEFAULT_COLUMNS: int
JUPYTER_DEFAULT_LINES: int
WINDOWS: bool
HighlighterType = Callable[[Union[str, Text]], Text]
JustifyMethod: Incomplete
OverflowMethod: Incomplete

class NoChange: ...

NO_CHANGE: NoChange

class ConsoleDimensions(NamedTuple):
    width: int
    height: int

class ConsoleOptions:
    size: ConsoleDimensions
    legacy_windows: bool
    min_width: int
    max_width: int
    is_terminal: bool
    encoding: str
    max_height: int
    justify: Optional[JustifyMethod]
    overflow: Optional[OverflowMethod]
    no_wrap: bool
    highlight: Optional[bool]
    markup: Optional[bool]
    height: Optional[int]
    @property
    def ascii_only(self) -> bool: ...
    def copy(self) -> ConsoleOptions: ...
    def update(self, *, width: Any = ..., min_width: Any = ..., max_width: Any = ..., justify: Any = ..., overflow: Any = ..., no_wrap: Any = ..., highlight: Any = ..., markup: Any = ..., height: Any = ...) -> ConsoleOptions: ...
    def update_width(self, width: int) -> ConsoleOptions: ...
    def update_height(self, height: int) -> ConsoleOptions: ...
    def reset_height(self) -> ConsoleOptions: ...
    def update_dimensions(self, width: int, height: int) -> ConsoleOptions: ...
    def __init__(self, size, legacy_windows, min_width, max_width, is_terminal, encoding, max_height, justify, overflow, no_wrap, highlight, markup, height) -> None: ...

class RichCast(Protocol):
    def __rich__(self) -> RenderableType: ...

class ConsoleRenderable(Protocol):
    def __rich_console__(self, console: Console, options: ConsoleOptions) -> RenderResult: ...
RenderableType = Union[ConsoleRenderable, RichCast, str]
RenderResult = Iterable[Union[RenderableType, Segment]]

class CaptureError(Exception): ...

class NewLine:
    count: int
    def __init__(self, count: int = ...) -> None: ...
    def __rich_console__(self, console: Console, options: ConsoleOptions) -> RenderResult: ...

class ScreenUpdate:
    x: int
    y: int
    def __init__(self, lines: List[List[Segment]], x: int, y: int) -> None: ...
    def __rich_console__(self, console: Console, options: ConsoleOptions) -> RenderResult: ...

class Capture:
    def __init__(self, console: Console) -> None: ...
    def __enter__(self) -> Capture: ...
    def __exit__(self, exc_type: Optional[Type[BaseException]], exc_val: Optional[BaseException], exc_tb: Optional[TracebackType]) -> None: ...
    def get(self) -> str: ...

class Theme:
    def __init__(self) -> None: ...

class ThemeStack:
    def __init__(self) -> None: ...

class ThemeContext:
    console: Console
    theme: Theme
    inherit: bool
    def __init__(self, console: Console, theme: Theme, inherit: bool = ...) -> None: ...
    def __enter__(self) -> ThemeContext: ...
    def __exit__(self, exc_type: Optional[Type[BaseException]], exc_val: Optional[BaseException], exc_tb: Optional[TracebackType]) -> None: ...

class Pager:
    def __init__(self) -> None: ...

class PagerContext:
    pager: Pager
    styles: bool
    links: bool
    def __init__(self, console: Console, pager: Optional[Pager] = ..., styles: bool = ..., links: bool = ...) -> None: ...
    def __enter__(self) -> PagerContext: ...
    def __exit__(self, exc_type: Optional[Type[BaseException]], exc_val: Optional[BaseException], exc_tb: Optional[TracebackType]) -> None: ...

class Screen:
    def __init__(self) -> None: ...

class ScreenContext:
    console: Console
    hide_cursor: bool
    screen: Screen
    def __init__(self, console: Console, hide_cursor: bool, style: str = ...) -> None: ...
    def update(self, *renderables: RenderableType, style: Optional[StyleType] = ...) -> None: ...
    def __enter__(self) -> ScreenContext: ...
    def __exit__(self, exc_type: Optional[Type[BaseException]], exc_val: Optional[BaseException], exc_tb: Optional[TracebackType]) -> None: ...

class Group:
    fit: bool
    def __init__(self, *renderables: RenderableType, fit: bool = ...) -> None: ...
    @property
    def renderables(self) -> List[RenderableType]: ...
    def __rich_measure__(self, console: Console, options: ConsoleOptions) -> Measurement: ...
    def __rich_console__(self, console: Console, options: ConsoleOptions) -> RenderResult: ...

def group(fit: bool = ...) -> Callable[[Callable[..., Iterable[RenderableType]]], Callable[..., Group]]: ...

COLOR_SYSTEMS: Dict[str, ColorSystem]

class ConsoleThreadLocals(threading.local):
    buffer: List[Segment]
    buffer_index: int
    def __init__(self, buffer, buffer_index) -> None: ...

class RenderHook(ABC, metaclass=abc.ABCMeta):
    @abstractmethod
    def process_renderables(self, renderables: List[RenderableType]) -> Iterable[RenderableType]: ...

def get_windows_console_features() -> WindowsConsoleFeatures: ...
def detect_legacy_windows() -> bool: ...

class FormatTimeCallable:
    def __call__(self, time: datetime) -> str: ...

class LogRender:
    def __init__(self) -> None: ...

class Control:
    def __init__(self) -> None: ...

class EmojiVariant:
    TEXT: str
    EMOJI: str

class Region:
    def __init__(self) -> None: ...

class Status:
    def __init__(self) -> None: ...

class TerminalTheme:
    def __init__(self) -> None: ...

