import abc
from _typeshed import Incomplete
from abc import ABC, abstractmethod
from rich.console import Console as Console, ConsoleOptions as ConsoleOptions, RenderResult as RenderResult, RenderableType as RenderableType
from rich.highlighter import ReprHighlighter as ReprHighlighter
from rich.segment import Segment as Segment
from rich.style import StyleType as StyleType
from threading import RLock as RLock
from typing import Any, Dict, Iterable, List, NamedTuple, Optional, Sequence, Tuple, Type, Union

class Region:
    def __init__(self) -> None: ...

class Result:
    def __init__(self, *args: Any) -> None: ...

class Tree:
    def __init__(self) -> None: ...

class LayoutRender(NamedTuple):
    region: Region
    lines: List[List[Segment]]

RegionMap: Incomplete
RenderMap: Incomplete

class LayoutError(Exception): ...
class NoSplitter(LayoutError): ...

class _Placeholder:
    highlighter: ReprHighlighter
    layout: Layout
    style: StyleType
    def __init__(self, layout: Layout, style: StyleType = ...) -> None: ...
    def __rich_console__(self, console: Console, options: ConsoleOptions) -> RenderResult: ...

class Splitter(ABC, metaclass=abc.ABCMeta):
    name: str
    @abstractmethod
    def get_tree_icon(self) -> str: ...
    @abstractmethod
    def divide(self, children: Sequence['Layout'], region: Region) -> Iterable[Tuple['Layout', Region]]: ...

class RowSplitter(Splitter):
    name: str
    def get_tree_icon(self) -> str: ...
    def divide(self, children: Sequence['Layout'], region: Region) -> Iterable[Tuple['Layout', Region]]: ...

class ColumnSplitter(Splitter):
    name: str
    def get_tree_icon(self) -> str: ...
    def divide(self, children: Sequence['Layout'], region: Region) -> Iterable[Tuple['Layout', Region]]: ...

class Layout:
    splitters: Dict[str, Type[Splitter]]
    size: Optional[int]
    minimum_size: int
    ratio: int
    name: Optional[str]
    visible: bool
    splitter: Splitter
    def __init__(self, renderable: Optional[RenderableType] = ..., *, name: Optional[str] = ..., size: Optional[int] = ..., minimum_size: int = ..., ratio: int = ..., visible: bool = ...) -> None: ...
    def __rich_repr__(self) -> Result: ...
    @property
    def renderable(self) -> RenderableType: ...
    @property
    def children(self) -> List[Layout]: ...
    @property
    def map(self) -> RenderMap: ...
    def get(self, name: str) -> Optional[Layout]: ...
    def __getitem__(self, name: str) -> Layout: ...
    @property
    def tree(self) -> Tree: ...
    def split(self, *layouts: Union[Layout, RenderableType], splitter: Union[str, Splitter] = ...) -> None: ...
    def add_split(self, *layouts: Union[Layout, RenderableType]) -> None: ...
    def split_row(self, *layouts: Union[Layout, RenderableType]) -> None: ...
    def split_column(self, *layouts: Union[Layout, RenderableType]) -> None: ...
    def unsplit(self) -> None: ...
    def update(self, renderable: RenderableType) -> None: ...
    def refresh_screen(self, console: Console, layout_name: str) -> None: ...
    def render(self, console: Console, options: ConsoleOptions) -> RenderMap: ...
    def __rich_console__(self, console: Console, options: ConsoleOptions) -> RenderResult: ...
