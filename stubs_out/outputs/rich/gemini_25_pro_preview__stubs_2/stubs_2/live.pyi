from rich.console import Console as Console, ConsoleRenderable as ConsoleRenderable, RenderHook, RenderableType as RenderableType
from rich.jupyter import JupyterMixin
from threading import Event, RLock as RLock, Thread
from types import TracebackType
from typing import Any, Callable, List, Optional, Type

class LiveRender:
    def __init__(self) -> None: ...
VerticalOverflowMethod = str

class _RefreshThread(Thread):
    live: Live
    refresh_per_second: float
    done: Event
    def __init__(self, live: Live, refresh_per_second: float) -> None: ...
    def stop(self) -> None: ...
    def run(self) -> None: ...

class Live(JupyterMixin, RenderHook):
    console: Console
    ipy_widget: Any
    auto_refresh: bool
    transient: bool
    refresh_per_second: float
    vertical_overflow: VerticalOverflowMethod
    def __init__(self, renderable: Optional[RenderableType] = ..., *, console: Optional[Console] = ..., screen: bool = ..., auto_refresh: bool = ..., refresh_per_second: float = ..., transient: bool = ..., redirect_stdout: bool = ..., redirect_stderr: bool = ..., vertical_overflow: VerticalOverflowMethod = ..., get_renderable: Optional[Callable[[], RenderableType]] = ...) -> None: ...
    @property
    def is_started(self) -> bool: ...
    def get_renderable(self) -> RenderableType: ...
    def start(self, refresh: bool = ...) -> None: ...
    def stop(self) -> None: ...
    def __enter__(self) -> Live: ...
    def __exit__(self, exc_type: Optional[Type[BaseException]], exc_val: Optional[BaseException], exc_tb: Optional[TracebackType]) -> None: ...
    @property
    def renderable(self) -> RenderableType: ...
    def update(self, renderable: RenderableType, *, refresh: bool = ...) -> None: ...
    def refresh(self) -> None: ...
    def process_renderables(self, renderables: List[RenderableType]) -> List[RenderableType]: ...
