from _typeshed import Incomplete
from typing import Any, Callable, Iterable, List, NamedTuple, Optional, Tuple

TextType: Incomplete
GetStyleCallable = Callable[[str], Optional[Any]]

class Span(NamedTuple):
    start: int
    end: int
    style: Any
    def __bool__(self) -> bool: ...
    def split(self, offset: int) -> Tuple['Span', Optional['Span']]: ...
    def move(self, offset: int) -> Span: ...
    def right_crop(self, offset: int) -> Span: ...
    def extend(self, cells: int) -> Span: ...

class Text:
    def __init__(self, text: str = ..., style: Any = ..., *, justify: Optional[str] = ..., overflow: Optional[str] = ..., no_wrap: Optional[bool] = ..., end: str = ..., tab_size: Optional[int] = ..., spans: Optional[List[Span]] = ...) -> None: ...
    def __len__(self) -> int: ...
    def __bool__(self) -> bool: ...
    def __add__(self, other: Any) -> Text: ...
    def __eq__(self, other: Any) -> bool: ...
    def __contains__(self, other: Any) -> bool: ...
    def __getitem__(self, slice: Any) -> Text: ...
    @property
    def cell_len(self) -> int: ...
    @property
    def markup(self) -> str: ...
    @classmethod
    def from_markup(cls, text: str, *, style: Any = ..., emoji: bool = ..., emoji_variant: Any = ..., justify: Optional[str] = ..., overflow: Optional[str] = ..., end: str = ...) -> Text: ...
    @classmethod
    def from_ansi(cls, text: str, *, style: Any = ..., justify: Optional[str] = ..., overflow: Optional[str] = ..., no_wrap: Optional[bool] = ..., end: str = ..., tab_size: int = ...) -> Text: ...
    @classmethod
    def styled(cls, text: str, style: Any = ..., *, justify: Optional[str] = ..., overflow: Optional[str] = ...) -> Text: ...
    @classmethod
    def assemble(cls, *parts: Any, style: Any = ..., justify: Optional[str] = ..., overflow: Optional[str] = ..., no_wrap: Optional[bool] = ..., end: str = ..., tab_size: int = ..., meta: Optional[Any] = ...) -> Text: ...
    @property
    def plain(self) -> str: ...
    @property
    def spans(self) -> List[Span]: ...
    def blank_copy(self, plain: str = ...) -> Text: ...
    def copy(self) -> Text: ...
    def stylize(self, style: Any, start: int = ..., end: Optional[int] = ...) -> None: ...
    def stylize_before(self, style: Any, start: int = ..., end: Optional[int] = ...) -> None: ...
    def apply_meta(self, meta: Any, start: int = ..., end: Optional[int] = ...) -> None: ...
    def on(self, meta: Optional[Any] = ..., **handlers: Any) -> Text: ...
    def remove_suffix(self, suffix: str) -> None: ...
    def get_style_at_offset(self, console: Any, offset: int) -> Any: ...
    def extend_style(self, spaces: int) -> None: ...
    def highlight_regex(self, re_highlight: Any, style: Any = ..., *, style_prefix: str = ...) -> int: ...
    def highlight_words(self, words: Iterable[str], style: Any, *, case_sensitive: bool = ...) -> int: ...
    def rstrip(self) -> None: ...
    def rstrip_end(self, size: int) -> None: ...
    def set_length(self, new_length: int) -> None: ...
    def __rich_console__(self, console: Any, options: Any) -> Iterable[Any]: ...
    def __rich_measure__(self, console: Any, options: Any) -> Any: ...
    def render(self, console: Any, end: str = ...) -> Iterable[Any]: ...
    def join(self, lines: Iterable['Text']) -> Text: ...
    def expand_tabs(self, tab_size: Optional[int] = ...) -> None: ...
    def truncate(self, max_width: int, *, overflow: Optional[str] = ..., pad: bool = ...) -> None: ...
    def pad(self, count: int, character: str = ...) -> None: ...
    def pad_left(self, count: int, character: str = ...) -> None: ...
    def pad_right(self, count: int, character: str = ...) -> None: ...
    def align(self, align: str, width: int, character: str = ...) -> None: ...
    def append(self, text: Any, style: Any = ...) -> Text: ...
    def append_text(self, text: Text) -> Text: ...
    def append_tokens(self, tokens: Iterable[Tuple[str, Any]]) -> Text: ...
    def copy_styles(self, text: Text) -> None: ...
    def split(self, separator: str = ..., *, include_separator: bool = ..., allow_blank: bool = ...) -> Any: ...
    def divide(self, offsets: Iterable[int]) -> Any: ...
    def right_crop(self, amount: int = ...) -> None: ...
    def wrap(self, console: Any, width: int, *, justify: Optional[str] = ..., overflow: Optional[str] = ..., tab_size: int = ..., no_wrap: Optional[bool] = ...) -> Any: ...
    def fit(self, width: int) -> Any: ...
    def detect_indentation(self) -> int: ...
    def with_indent_guides(self, indent_size: Optional[int] = ..., *, character: str = ..., style: str = ...) -> Text: ...
