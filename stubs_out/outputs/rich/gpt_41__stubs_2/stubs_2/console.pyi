from typing import Any, Callable, IO, Iterable, List, Mapping, NamedTuple, Optional, Protocol, Union

class ConsoleDimensions(NamedTuple):
    width: int
    height: int

class ConsoleOptions:
    size: ConsoleDimensions
    legacy_windows: bool
    min_width: int
    max_width: int
    is_terminal: bool
    encoding: str
    max_height: Optional[int]
    justify: Optional[str]
    overflow: Optional[str]
    no_wrap: bool
    highlight: Optional[bool]
    markup: Optional[bool]
    height: Optional[int]
    def ascii_only(self) -> bool: ...
    def copy(self) -> ConsoleOptions: ...
    def update(self, *, width: Any = ..., min_width: Any = ..., max_width: Any = ..., justify: Any = ..., overflow: Any = ..., no_wrap: Any = ..., highlight: Any = ..., markup: Any = ..., height: Any = ...) -> ConsoleOptions: ...
    def update_width(self, width: int) -> ConsoleOptions: ...
    def update_height(self, height: int) -> ConsoleOptions: ...
    def reset_height(self) -> ConsoleOptions: ...
    def update_dimensions(self, width: int, height: int) -> ConsoleOptions: ...

class RichCast(Protocol):
    def __rich__(self) -> Any: ...

class ConsoleRenderable(Protocol):
    def __rich_console__(self, console: Any, options: Any) -> Iterable[Any]: ...
RenderableType = Union[ConsoleRenderable, RichCast, str]
RenderResult = Iterable[Union[RenderableType, Any]]

class NoChange: ...

NO_CHANGE: NoChange

class CaptureError(Exception): ...

class NewLine:
    def __init__(self, count: int = ...) -> None: ...
    def __rich_console__(self, console: Any, options: Any) -> Iterable[Any]: ...

class ScreenUpdate:
    def __init__(self, lines: Any, x: int, y: int) -> None: ...
    def __rich_console__(self, console: Any, options: Any) -> Iterable[Any]: ...

class Capture:
    def __init__(self, console: Any) -> None: ...
    def __enter__(self) -> Capture: ...
    def __exit__(self, exc_type: Any, exc_val: Any, exc_tb: Any) -> None: ...
    def get(self) -> str: ...

class ThemeContext:
    def __init__(self, console: Any, theme: Any, inherit: bool = ...) -> None: ...
    def __enter__(self) -> ThemeContext: ...
    def __exit__(self, exc_type: Any, exc_val: Any, exc_tb: Any) -> None: ...

class PagerContext:
    def __init__(self, console: Any, pager: Optional[Any] = ..., styles: bool = ..., links: bool = ...) -> None: ...
    def __enter__(self) -> PagerContext: ...
    def __exit__(self, exc_type: Any, exc_val: Any, exc_tb: Any) -> None: ...

class ScreenContext:
    def __init__(self, console: Any, hide_cursor: bool, style: str = ...) -> None: ...
    def update(self, *renderables: Any, style: Optional[Any] = ...) -> None: ...
    def __enter__(self) -> ScreenContext: ...
    def __exit__(self, exc_type: Any, exc_val: Any, exc_tb: Any) -> None: ...

class Group:
    def __init__(self, *renderables: Any, fit: bool = ...) -> None: ...
    @property
    def renderables(self) -> List[Any]: ...
    def __rich_measure__(self, console: Any, options: Any) -> Any: ...
    def __rich_console__(self, console: Any, options: Any) -> Iterable[Any]: ...

def group(fit: bool = ...) -> Callable[[Callable[..., Iterable[Any]]], Callable[..., Group]]: ...
def get_windows_console_features() -> Any: ...
def detect_legacy_windows() -> bool: ...

class Console:
    def __init__(self, *, color_system: Optional[str] = ..., force_terminal: Optional[bool] = ..., force_jupyter: Optional[bool] = ..., force_interactive: Optional[bool] = ..., soft_wrap: bool = ..., theme: Optional[Any] = ..., stderr: bool = ..., file: Optional[IO[str]] = ..., quiet: bool = ..., width: Optional[int] = ..., height: Optional[int] = ..., style: Optional[Any] = ..., no_color: Optional[bool] = ..., tab_size: int = ..., record: bool = ..., markup: bool = ..., emoji: bool = ..., emoji_variant: Optional[Any] = ..., highlight: bool = ..., log_time: bool = ..., log_path: bool = ..., log_time_format: str = ..., highlighter: Optional[Any] = ..., legacy_windows: Optional[bool] = ..., safe_box: bool = ..., get_datetime: Optional[Callable[[], Any]] = ..., get_time: Optional[Callable[[], float]] = ..., _environ: Optional[Mapping[str, str]] = ...) -> None: ...
    @property
    def file(self) -> IO[str]: ...
    @property
    def color_system(self) -> Optional[str]: ...
    @property
    def encoding(self) -> str: ...
    @property
    def is_terminal(self) -> bool: ...
    @property
    def is_dumb_terminal(self) -> bool: ...
    @property
    def options(self) -> ConsoleOptions: ...
    @property
    def size(self) -> ConsoleDimensions: ...
    @property
    def width(self) -> int: ...
    @property
    def height(self) -> int: ...
    def bell(self) -> None: ...
    def capture(self) -> Capture: ...
    def pager(self, pager: Optional[Any] = ..., styles: bool = ..., links: bool = ...) -> PagerContext: ...
    def line(self, count: int = ...) -> None: ...
    def clear(self, home: bool = ...) -> None: ...
    def status(self, status: Any, *, spinner: str = ..., spinner_style: str = ..., speed: float = ..., refresh_per_second: float = ...) -> Any: ...
    def show_cursor(self, show: bool = ...) -> bool: ...
    def set_alt_screen(self, enable: bool = ...) -> bool: ...
    @property
    def is_alt_screen(self) -> bool: ...
    def set_window_title(self, title: str) -> bool: ...
    def screen(self, hide_cursor: bool = ..., style: Optional[Any] = ...) -> ScreenContext: ...
    def measure(self, renderable: Any, *, options: Optional[ConsoleOptions] = ...) -> Any: ...
    def render(self, renderable: Any, options: Optional[ConsoleOptions] = ...) -> Iterable[Any]: ...
    def render_lines(self, renderable: Any, options: Optional[ConsoleOptions] = ..., *, style: Optional[Any] = ..., pad: bool = ..., new_lines: bool = ...) -> List[List[Any]]: ...
    def render_str(self, text: str, *, style: str = ..., justify: Optional[str] = ..., overflow: Optional[str] = ..., emoji: Optional[bool] = ..., markup: Optional[bool] = ..., highlight: Optional[bool] = ..., highlighter: Optional[Any] = ...) -> Any: ...
    def get_style(self, name: Any, *, default: Optional[Any] = ...) -> Any: ...
    def rule(self, title: str = ..., *, characters: str = ..., style: str = ..., align: str = ...) -> None: ...
    def control(self, *control: Any) -> None: ...
    def out(self, *objects: Any, sep: str = ..., end: str = ..., style: Optional[Any] = ..., highlight: Optional[bool] = ...) -> None: ...
    def print(self, *objects: Any, sep: str = ..., end: str = ..., style: Optional[Any] = ..., justify: Optional[str] = ..., overflow: Optional[str] = ..., no_wrap: Optional[bool] = ..., emoji: Optional[bool] = ..., markup: Optional[bool] = ..., highlight: Optional[bool] = ..., width: Optional[int] = ..., height: Optional[int] = ..., crop: bool = ..., soft_wrap: Optional[bool] = ..., new_line_start: bool = ...) -> None: ...
    def print_json(self, json: Optional[str] = ..., *, data: Any = ..., indent: int = ..., highlight: bool = ..., skip_keys: bool = ..., ensure_ascii: bool = ..., check_circular: bool = ..., allow_nan: bool = ..., default: Optional[Callable[[Any], Any]] = ..., sort_keys: bool = ...) -> None: ...
    def update_screen(self, renderable: Any, *, region: Optional[Any] = ..., options: Optional[ConsoleOptions] = ...) -> None: ...
    def update_screen_lines(self, lines: List[List[Any]], x: int = ..., y: int = ...) -> None: ...
    def print_exception(self, *, width: int = ..., extra_lines: int = ..., theme: Optional[str] = ..., word_wrap: bool = ..., show_locals: bool = ..., suppress: Any = ..., max_frames: int = ...) -> None: ...
    def log(self, *objects: Any, sep: str = ..., end: str = ..., style: Optional[Any] = ..., justify: Optional[str] = ..., emoji: Optional[bool] = ..., markup: Optional[bool] = ..., highlight: Optional[bool] = ..., log_locals: bool = ..., _stack_offset: int = ...) -> None: ...
    def on_broken_pipe(self) -> None: ...
    def export_text(self, *, clear: bool = ..., styles: bool = ...) -> str: ...
    def save_text(self, path: str, *, clear: bool = ..., styles: bool = ...) -> None: ...
    def export_html(self, *, theme: Optional[Any] = ..., clear: bool = ..., code_format: Optional[str] = ..., inline_styles: bool = ...) -> str: ...
    def save_html(self, path: str, *, theme: Optional[Any] = ..., clear: bool = ..., code_format: str = ..., inline_styles: bool = ...) -> None: ...
    def export_svg(self, *, title: str = ..., theme: Optional[Any] = ..., clear: bool = ..., code_format: Optional[str] = ..., font_aspect_ratio: float = ..., unique_id: Optional[str] = ...) -> str: ...
    def save_svg(self, path: str, *, title: str = ..., theme: Optional[Any] = ..., clear: bool = ..., code_format: Optional[str] = ..., font_aspect_ratio: float = ..., unique_id: Optional[str] = ...) -> None: ...
