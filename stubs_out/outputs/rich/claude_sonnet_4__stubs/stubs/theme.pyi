from .default_styles import DEFAULT_STYLES as DEFAULT_STYLES
from .style import Style as Style, StyleType as StyleType
from .terminal_theme import TerminalTheme as TerminalTheme
from typing import Dict, Optional

class Theme:
    def __init__(self, styles: Optional[Dict[str, StyleType]] = ..., inherit: bool = ...) -> None: ...
    @property
    def styles(self) -> Dict[str, Style]: ...
    def read(self, name: str, default: Optional[StyleType] = ...) -> Optional[Style]: ...

class ThemeStack:
    def __init__(self, theme: Theme) -> None: ...
    @property
    def top(self) -> Theme: ...
    def get(self, name: str) -> Optional[Style]: ...
    def push_theme(self, theme: Theme, inherit: bool = ...) -> None: ...
    def pop_theme(self) -> Theme: ...
