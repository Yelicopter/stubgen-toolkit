from .text import Text as Text
from typing import Iterator, List

class Lines:
    def __init__(self, lines: List[Text] = ...) -> None: ...
    def __iter__(self) -> Iterator[Text]: ...
    def __getitem__(self, index: int) -> Text: ...
    def __setitem__(self, index: int, value: Text) -> None: ...
    def __len__(self) -> int: ...
    def append(self, line: Text) -> None: ...
    def extend(self, lines: List[Text]) -> None: ...
    def pop(self, index: int = ...) -> Text: ...
    def justify(self, console: Console, width: int, justify: str = ..., overflow: str = ...) -> None: ...
