import click
import typer
from pathlib import Path
from typer.core import TyperGroup
from types import ModuleType
from typing import Any, List, Optional

app: typer.Typer
utils_app: typer.Typer

class State:
    app: Optional[str]
    func: Optional[str]
    file: Optional[Path]
    module: Optional[str]
    def __init__(self) -> None: ...

state: State

def maybe_update_state(ctx: click.Context) -> None: ...

class TyperCLIGroup(TyperGroup):
    def list_commands(self, ctx: click.Context) -> List[str]: ...
    def get_command(self, ctx: click.Context, name: str) -> Optional[click.Command]: ...
    def invoke(self, ctx: click.Context) -> Any: ...
    def maybe_add_run(self, ctx: click.Context) -> None: ...

def get_typer_from_module(module: ModuleType) -> Optional[typer.Typer]: ...
def get_typer_from_state() -> Optional[typer.Typer]: ...
def maybe_add_run_to_cli(cli: click.Group) -> None: ...
def print_version(ctx: click.Context, param: click.Parameter, value: Any) -> None: ...
def callback(ctx: click.Context, *, path_or_module: Optional[str] = ..., app: Optional[str] = ..., func: Optional[str] = ..., version: bool = ...) -> None: ...
def get_docs_for_click(*, obj: click.BaseCommand, ctx: click.Context, indent: int = ..., name: str = ..., call_prefix: str = ..., title: Optional[str] = ...) -> str: ...
def docs(ctx: click.Context, name: str = ..., output: Optional[Path] = ..., title: Optional[str] = ...) -> None: ...
def main() -> Any: ...
