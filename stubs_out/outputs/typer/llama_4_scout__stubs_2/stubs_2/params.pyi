import click
from click import Argument as Argument, Option as Option
from typing import Any, Callable, overload

@overload
def Option(default: Any = ..., *param_decls: Any, callback: Callable[..., Any] = ..., metavar: Any = ..., expose_value: bool = ..., is_eager: bool = ..., envvar: Any = ..., shell_complete: Callable[..., Any] = ..., autocompletion: Callable[..., Any] = ..., default_factory: Callable[..., Any] = ..., parser: Any = ..., click_type: Any = ..., show_default: bool = ..., prompt: bool = ..., confirmation_prompt: bool = ..., prompt_required: bool = ..., hide_input: bool = ..., is_flag: bool = ..., flag_value: Any = ..., count: bool = ..., allow_from_autoenv: bool = ..., help: str = ..., hidden: bool = ..., show_choices: bool = ..., show_envvar: bool = ..., case_sensitive: bool = ..., min: Any = ..., max: Any = ..., clamp: bool = ..., formats: Any = ..., mode: Any = ..., encoding: Any = ..., errors: Any = ..., lazy: Any = ..., atomic: bool = ..., exists: bool = ..., file_okay: bool = ..., dir_okay: bool = ..., writable: bool = ..., readable: bool = ..., resolve_path: bool = ..., allow_dash: bool = ..., path_type: Any = ..., rich_help_panel: str = ...) -> click.Option: ...
@overload
def Argument(default: Any = ..., *, callback: Callable[..., Any] = ..., metavar: Any = ..., expose_value: bool = ..., is_eager: bool = ..., envvar: Any = ..., shell_complete: Callable[..., Any] = ..., autocompletion: Callable[..., Any] = ..., default_factory: Callable[..., Any] = ..., parser: Any = ..., click_type: Any = ..., show_default: bool = ..., show_choices: bool = ..., show_envvar: bool = ..., help: str = ..., hidden: bool = ..., case_sensitive: bool = ..., min: Any = ..., max: Any = ..., clamp: bool = ..., formats: Any = ..., mode: Any = ..., encoding: Any = ..., errors: Any = ..., lazy: Any = ..., atomic: bool = ..., exists: bool = ..., file_okay: bool = ..., dir_okay: bool = ..., writable: bool = ..., readable: bool = ..., resolve_path: bool = ..., allow_dash: bool = ..., path_type: Any = ..., rich_help_panel: str = ...) -> click.Argument: ...
