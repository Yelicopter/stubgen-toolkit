import typer
from typing import Any, List, Optional

class State:
    app: Any
    func: Any
    file: Any
    module: Any
    def __init__(self) -> None: ...

state: State

def maybe_update_state(ctx: Any) -> None: ...

class TyperCLIGroup(typer.core.TyperGroup):
    def list_commands(self, ctx: Any) -> List[str]: ...
    def get_command(self, ctx: Any, name: str) -> Any: ...
    def invoke(self, ctx: Any) -> Any: ...
    def maybe_add_run(self, ctx: Any) -> None: ...

def get_typer_from_module(module: Any) -> Optional[typer.Typer]: ...
def get_typer_from_state() -> Optional[typer.Typer]: ...
def maybe_add_run_to_cli(cli: Any) -> None: ...
def print_version(ctx: Any, param: Any, value: Any) -> None: ...
def callback(ctx: Any, *, path_or_module: Any = ..., app: Any = ..., func: Any = ..., version: Any = ...) -> None: ...
def get_docs_for_click(*, obj: Any, ctx: Any, indent: int = ..., name: str = ..., call_prefix: str = ..., title: Any = ...) -> str: ...
def docs(ctx: Any, name: str = ..., output: Any = ..., title: Any = ...) -> None: ...
def main() -> Any: ...

app: typer.Typer
utils_app: typer.Typer
