from ..config import Config as Config
from ..data_loader.duck_db_connection_manager import DuckDBConnectionManager as DuckDBConnectionManager
from ..query_builders.base_query_builder import BaseQueryBuilder as BaseQueryBuilder
from ..query_builders.sql_parser import SQLParser as SQLParser
from .state import AgentState as AgentState
from pandasai.dataframe.base import DataFrame
from pandasai.dataframe.virtual_dataframe import VirtualDataFrame as VirtualDataFrame
from pandasai.sandbox.sandbox import Sandbox as Sandbox
from pandasai.vectorstores.vectorstore import VectorStore as VectorStore
from typing import Any, List, Optional, Union

class Agent:
    description: Optional[str]
    def __init__(self, dfs: Union[DataFrame, VirtualDataFrame, List[Union[DataFrame, VirtualDataFrame]]], config: Optional[Union[Config, dict]] = ..., memory_size: int = ..., vectorstore: Optional[VectorStore] = ..., description: Optional[str] = ..., sandbox: Optional[Sandbox] = ...) -> None: ...
    def chat(self, query: str, output_type: Optional[str] = ...) -> Any: ...
    def follow_up(self, query: str, output_type: Optional[str] = ...) -> Any: ...
    def generate_code(self, query: Any) -> str: ...
    def execute_code(self, code: str) -> Any: ...
    def generate_code_with_retries(self, query: str) -> str: ...
    def execute_with_retries(self, code: str) -> Any: ...
    def train(self, queries: Optional[str] = ..., codes: Optional[str] = ..., docs: Optional[List[str]] = ...) -> None: ...
    def clear_memory(self) -> None: ...
    def add_message(self, message: str, is_user: bool = ...) -> None: ...
    def start_new_conversation(self) -> None: ...
    @property
    def last_generated_code(self) -> Any: ...
    @property
    def last_code_executed(self) -> Any: ...
    @property
    def last_prompt_used(self) -> Any: ...
