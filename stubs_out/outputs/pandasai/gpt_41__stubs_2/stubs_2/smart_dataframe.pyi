import pandas as pd
from typing import Any, List, Optional

class SmartDataframe:
    def __init__(self, df: Any, name: Optional[str] = ..., description: Optional[str] = ..., custom_head: Optional[Any] = ..., config: Optional[Any] = ...) -> None: ...
    def load_df(self, df: Any, name: Optional[str], description: Optional[str], custom_head: Optional[Any]) -> Any: ...
    def chat(self, query: str, output_type: Optional[str] = ...) -> Any: ...
    @property
    def head_df(self) -> pd.DataFrame: ...
    @property
    def head_csv(self) -> str: ...
    @property
    def last_prompt(self) -> Any: ...
    @property
    def last_prompt_id(self) -> Any: ...
    @property
    def last_code_generated(self) -> Any: ...
    @property
    def last_code_executed(self) -> Any: ...
    def original_import(self) -> Any: ...
    @property
    def logger(self) -> Any: ...
    @property
    def logs(self) -> Any: ...
    @property
    def verbose(self) -> Any: ...
    @property
    def save_logs(self) -> Any: ...
    @property
    def save_charts(self) -> Any: ...
    @property
    def save_charts_path(self) -> Any: ...
    @property
    def table_name(self) -> Any: ...
    @property
    def table_description(self) -> Any: ...
    @property
    def custom_head(self) -> pd.DataFrame: ...
    def __len__(self) -> int: ...
    def __eq__(self, other: Any) -> bool: ...
    def __getattr__(self, name: str) -> Any: ...
    def __getitem__(self, key: Any) -> Any: ...
    def __setitem__(self, key: Any, value: Any) -> None: ...

def load_smartdataframes(dfs: List[Any], config: Optional[Any]) -> List[SmartDataframe]: ...
