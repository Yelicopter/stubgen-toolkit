import pandas as pd
from ..config import Config
from pandasai.agent.base import Agent as Agent
from pandasai.dataframe.base import DataFrame
from typing import Any, List, Optional, Union

class SmartDatalake:
    def __init__(self, dfs: List[pd.DataFrame], config: Optional[Union[Config, dict]] = ...) -> None: ...
    def load_dfs(self, dfs: List[pd.DataFrame]) -> List[DataFrame]: ...
    def chat(self, query: str, output_type: Optional[str] = ...) -> Any: ...
    def clear_memory(self) -> None: ...
    @property
    def last_prompt(self) -> Any: ...
    @property
    def last_prompt_id(self) -> Optional[str]: ...
    @property
    def logs(self) -> Any: ...
    @property
    def logger(self) -> Any: ...
    @property
    def config(self) -> Config: ...
    @property
    def verbose(self) -> bool: ...
    @property
    def save_logs(self) -> bool: ...
    @property
    def custom_prompts(self) -> Any: ...
    @property
    def save_charts(self) -> bool: ...
    @property
    def save_charts_path(self) -> str: ...
    @property
    def last_code_generated(self) -> Any: ...
    @property
    def last_code_executed(self) -> Any: ...
    @property
    def last_result(self) -> Any: ...
    @property
    def last_error(self) -> Any: ...
    @property
    def dfs(self) -> List[DataFrame]: ...
    @property
    def memory(self) -> Any: ...
