from typing import Any, List

class Log: ...

class Logger:
    def __init__(self, save_logs: bool = ..., verbose: bool = ...) -> None: ...
    def log(self, message: str, level: int = ...) -> None: ...
    @property
    def logs(self) -> List[Any]: ...
    @property
    def verbose(self) -> bool: ...
    @property
    def save_logs(self) -> bool: ...
