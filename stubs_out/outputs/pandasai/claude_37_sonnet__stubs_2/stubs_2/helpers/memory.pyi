from typing import Any, Dict, List, Optional

class Memory:
    agent_description: Optional[str]
    def __init__(self, memory_size: int = ..., agent_description: Optional[str] = ...) -> None: ...
    def add(self, message: str, is_user: bool) -> None: ...
    def count(self) -> int: ...
    def all(self) -> List[Dict[str, Any]]: ...
    def last(self) -> Dict[str, Any]: ...
    def get_messages(self, limit: Optional[int] = ...) -> List[str]: ...
    def get_conversation(self, limit: Optional[int] = ...) -> str: ...
    def get_previous_conversation(self) -> str: ...
    def get_last_message(self) -> str: ...
    def to_json(self) -> List[Dict[str, Any]]: ...
    def to_openai_messages(self) -> List[Dict[str, str]]: ...
    def clear(self) -> None: ...
    @property
    def size(self) -> int: ...
