import ast
from pandasai.agent.state import AgentState as AgentState
from typing import List, Tuple

class CodeCleaner:
    context: AgentState
    def __init__(self, context: AgentState) -> None: ...
    def get_target_names(self, targets: List[ast.AST]) -> Tuple[List[str], bool, ast.AST]: ...
    def check_is_df_declaration(self, node: ast.Assign) -> bool: ...
    def clean_code(self, code: str) -> str: ...
