import abc
from abc import ABC, abstractmethod
from typing import Any, Iterable, List, Optional

class VectorStore(ABC, metaclass=abc.ABCMeta):
    @abstractmethod
    def add_question_answer(self, queries: Iterable[str], codes: Iterable[str], ids: Optional[Iterable[str]] = ..., metadatas: Optional[List[dict[str, Any]]] = ...) -> List[str]: ...
    @abstractmethod
    def add_docs(self, docs: Iterable[str], ids: Optional[Iterable[str]] = ..., metadatas: Optional[List[dict[str, Any]]] = ...) -> List[str]: ...
    def update_question_answer(self, ids: Iterable[str], queries: Iterable[str], codes: Iterable[str], metadatas: Optional[List[dict[str, Any]]] = ...) -> List[str]: ...
    def update_docs(self, ids: Iterable[str], docs: Iterable[str], metadatas: Optional[List[dict[str, Any]]] = ...) -> List[str]: ...
    def delete_question_and_answers(self, ids: Optional[List[str]] = ...) -> Optional[bool]: ...
    def delete_docs(self, ids: Optional[List[str]] = ...) -> Optional[bool]: ...
    def delete_collection(self, collection_name: str) -> Optional[bool]: ...
    def get_relevant_question_answers(self, question: str, k: int = ...) -> List[Any]: ...
    def get_relevant_docs(self, question: str, k: int = ...) -> List[Any]: ...
    def get_relevant_question_answers_by_id(self, ids: Iterable[str]) -> List[Any]: ...
    def get_relevant_docs_by_id(self, ids: Iterable[str]) -> List[Any]: ...
    @abstractmethod
    def get_relevant_qa_documents(self, question: str, k: int = ...) -> List[Any]: ...
    @abstractmethod
    def get_relevant_docs_documents(self, question: str, k: int = ...) -> List[Any]: ...
