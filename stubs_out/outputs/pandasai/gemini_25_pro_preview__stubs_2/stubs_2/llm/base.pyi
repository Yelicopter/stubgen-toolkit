import abc
from abc import abstractmethod
from pandasai.agent.state import AgentState as AgentState
from pandasai.core.prompts.base import BasePrompt as BasePrompt
from pandasai.helpers.memory import Memory as Memory
from typing import Any, Optional, Union

class LLM(metaclass=abc.ABCMeta):
    last_prompt: Optional[str]
    api_key: Optional[str]
    def __init__(self, api_key: Optional[str] = ..., **kwargs: Any) -> None: ...
    def is_pandasai_llm(self) -> bool: ...
    @property
    def type(self) -> str: ...
    def prepend_system_prompt(self, prompt: BasePrompt, memory: Memory) -> Union[BasePrompt, str]: ...
    def get_system_prompt(self, memory: Memory) -> str: ...
    def get_messages(self, memory: Memory) -> str: ...
    @abstractmethod
    def call(self, instruction: BasePrompt, context: Optional[AgentState] = ...) -> str: ...
    def generate_code(self, instruction: BasePrompt, context: AgentState) -> str: ...
