import pandas as pd
import uuid
from pandasai.agent.base import Agent as Agent
from pandasai.config import Config as Config
from pandasai.dataframe.base import DataFrame
from pandasai.helpers.logger import Logger as Logger
from pandasai.helpers.memory import Memory as Memory
from typing import Any, Dict, List, Optional, Union

class SmartDatalake:
    def __init__(self, dfs: List[Union[pd.DataFrame, Any]], config: Optional[Union[Config, Dict[str, Any]]] = ...) -> None: ...
    def load_dfs(self, dfs: List[Union[pd.DataFrame, Any]]) -> List[DataFrame]: ...
    def chat(self, query: str, output_type: Optional[str] = ...) -> Any: ...
    def clear_memory(self) -> None: ...
    @property
    def last_prompt(self) -> str: ...
    @property
    def last_prompt_id(self) -> uuid.UUID: ...
    @property
    def logs(self) -> List[Dict[str, Any]]: ...
    @property
    def logger(self) -> Logger: ...
    @property
    def config(self) -> Config: ...
    @property
    def verbose(self) -> bool: ...
    @property
    def save_logs(self) -> bool: ...
    @property
    def custom_prompts(self) -> Any: ...
    @property
    def save_charts(self) -> bool: ...
    @property
    def save_charts_path(self) -> str: ...
    @property
    def last_code_generated(self) -> Optional[str]: ...
    @property
    def last_code_executed(self) -> Optional[str]: ...
    @property
    def last_result(self) -> Any: ...
    @property
    def last_error(self) -> Optional[str]: ...
    @property
    def dfs(self) -> List[DataFrame]: ...
    @property
    def memory(self) -> Memory: ...
