import abc
from abc import ABC, abstractmethod
from typing import Iterable, List

class VectorStore(ABC, metaclass=abc.ABCMeta):
    @abstractmethod
    def add_question_answer(self, queries: List[str], codes: List[str], ids: Iterable | None = ..., metadatas: List | None = ...) -> List: ...
    @abstractmethod
    def add_docs(self, docs: Iterable[str], ids: Iterable | None = ..., metadatas: List | None = ...) -> List: ...
    def update_question_answer(self, ids: Iterable, queries: List[str], codes: List[str], metadatas: List | None = ...) -> List: ...
    def update_docs(self, ids: Iterable, docs: Iterable[str], metadatas: List | None = ...) -> List: ...
    def delete_question_and_answers(self, ids: Iterable | None = ...) -> bool | None: ...
    def delete_docs(self, ids: Iterable | None = ...) -> bool | None: ...
    def delete_collection(self, collection_name: str) -> bool | None: ...
    def get_relevant_question_answers(self, question: str, k: int = ...) -> List: ...
    def get_relevant_docs(self, question: str, k: int = ...) -> List: ...
    def get_relevant_question_answers_by_id(self, ids: List) -> List: ...
    def get_relevant_docs_by_id(self, ids: List) -> List: ...
    @abstractmethod
    def get_relevant_qa_documents(self, question: str, k: int = ...) -> List: ...
    @abstractmethod
    def get_relevant_docs_documents(self, question: str, k: int = ...) -> List: ...
