import pandas as pd
from functools import cached_property as cached_property
from io import StringIO as StringIO
from pandasai.agent import Agent as Agent
from pandasai.dataframe import DataFrame
from typing import Any, List

class SmartDataframe:
    def __init__(self, df: pd.DataFrame, name: str | None = ..., description: str | None = ..., custom_head: pd.DataFrame | None = ..., config: Config | None = ...) -> None: ...
    def load_df(self, df: pd.DataFrame, name: str | None, description: str | None, custom_head: pd.DataFrame | None) -> DataFrame: ...
    def chat(self, query: str, output_type: str | None = ...) -> Any: ...
    @cached_property
    def head_df(self) -> pd.DataFrame: ...
    @cached_property
    def head_csv(self) -> str: ...
    @property
    def last_prompt(self) -> str: ...
    @property
    def last_prompt_id(self) -> str: ...
    @property
    def last_code_generated(self) -> str: ...
    @property
    def last_code_executed(self) -> str: ...
    def original_import(self) -> Any: ...
    @property
    def logger(self) -> Logger: ...
    @property
    def logs(self) -> List: ...
    @property
    def verbose(self) -> bool: ...
    @property
    def save_logs(self) -> bool: ...
    @property
    def save_charts(self) -> bool: ...
    @property
    def save_charts_path(self) -> str: ...
    @property
    def table_name(self) -> str: ...
    @property
    def table_description(self) -> str: ...
    @property
    def custom_head(self) -> pd.DataFrame: ...
    def __len__(self) -> int: ...
    def __eq__(self, other: object) -> bool: ...
    def __getattr__(self, name: str) -> Any: ...
    def __getitem__(self, key: Any) -> Any: ...
    def __setitem__(self, key: Any, value: Any) -> None: ...
