import pandas as pd
from pandasai.dataframe import VirtualDataFrame as VirtualDataFrame
from pandasai.query_builders import ViewQueryBuilder as ViewQueryBuilder
from typing import Any, Dict, Optional

class ViewDatasetLoader:
    def __init__(self, schema: Any, dataset_path: str) -> None: ...
    @property
    def query_builder(self) -> ViewQueryBuilder: ...
    def load(self) -> VirtualDataFrame: ...
    def execute_local_query(self, query: str, params: Optional[Dict[str, Any]] = ...) -> pd.DataFrame: ...
    def execute_query(self, query: str, params: Optional[Dict[str, Any]] = ...) -> pd.DataFrame: ...
