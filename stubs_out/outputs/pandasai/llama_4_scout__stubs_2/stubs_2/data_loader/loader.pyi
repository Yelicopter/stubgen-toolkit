import abc
from abc import ABC, abstractmethod
from pandasai.dataframe import DataFrame as DataFrame
from pandasai.query_builders import BaseQueryBuilder as BaseQueryBuilder
from typing import Any, Dict, Optional

class DatasetLoader(ABC, metaclass=abc.ABCMeta):
    def __init__(self, schema: Any, dataset_path: str) -> None: ...
    @property
    @abstractmethod
    def query_builder(self) -> BaseQueryBuilder: ...
    @abstractmethod
    def execute_query(self, query: str, params: Optional[Dict[str, Any]] = ...) -> Any: ...
    @classmethod
    def create_loader_from_schema(cls, schema: Any, dataset_path: str) -> DatasetLoader: ...
    @classmethod
    def create_loader_from_path(cls, dataset_path: str) -> DatasetLoader: ...
    def load(self) -> DataFrame: ...
