class Memory:
    agent_description: str
    def __init__(self, memory_size: int = ..., agent_description: Optional[str] = ...) -> None: ...
    def add(self, message: str, is_user: bool) -> None: ...
    def count(self) -> int: ...
    def all(self) -> list: ...
    def last(self) -> dict: ...
    def get_messages(self, limit: Optional[int] = ...) -> list: ...
    def get_conversation(self, limit: Optional[int] = ...) -> str: ...
    def get_previous_conversation(self) -> str: ...
    def get_last_message(self) -> str: ...
    def to_json(self) -> List[dict]: ...
    def to_openai_messages(self) -> List[dict]: ...
    def clear(self) -> None: ...
    @property
    def size(self) -> int: ...
