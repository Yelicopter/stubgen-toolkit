import pandas as pd
from ..config import Config
from ..helpers.logger import Logger
from functools import cached_property as cached_property
from io import StringIO as StringIO
from pandasai.agent import Agent as Agent
from pandasai.dataframe.base import DataFrame
from typing import Any, List, Optional, Union

class SmartDataframe:
    dataframe: DataFrame
    def __init__(self, df: Any, name: str = ..., description: str = ..., custom_head: pd.DataFrame = ..., config: Any = ...) -> None: ...
    def load_df(self, df, name: str, description: str, custom_head: pd.DataFrame) -> DataFrame: ...
    def chat(self, query: str, output_type: Optional[str] = ...) -> Any: ...
    @cached_property
    def head_df(self) -> pd.DataFrame: ...
    @cached_property
    def head_csv(self) -> str: ...
    @property
    def last_prompt(self) -> Any: ...
    @property
    def last_prompt_id(self) -> Optional[str]: ...
    @property
    def last_code_generated(self) -> Any: ...
    @property
    def last_code_executed(self) -> Any: ...
    def original_import(self) -> Any: ...
    @property
    def logger(self) -> Logger: ...
    @property
    def logs(self) -> Any: ...
    @property
    def verbose(self) -> bool: ...
    @property
    def save_logs(self) -> bool: ...
    @property
    def save_charts(self) -> bool: ...
    @property
    def save_charts_path(self) -> str: ...
    @property
    def table_name(self) -> str: ...
    @property
    def table_description(self) -> str: ...
    @property
    def custom_head(self) -> pd.DataFrame: ...
    def __len__(self) -> int: ...
    def __eq__(self, other) -> bool: ...
    def __getattr__(self, name) -> Any: ...
    def __getitem__(self, key) -> Any: ...
    def __setitem__(self, key, value) -> Any: ...

def load_smartdataframes(dfs: List[Union[pd.DataFrame, Any]], config: Config) -> List[SmartDataframe]: ...
