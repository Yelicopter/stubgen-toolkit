from ._transcripts import FetchedTranscript as FetchedTranscript, TranscriptList as TranscriptList, TranscriptListFetcher as TranscriptListFetcher
from .proxies import GenericProxyConfig as GenericProxyConfig, ProxyConfig as ProxyConfig
from requests import Session
from typing import Dict, Iterable, List, Optional, Tuple

class YouTubeTranscriptApi:
    def __init__(self, proxy_config: Optional[ProxyConfig] = ..., http_client: Optional[Session] = ...) -> None: ...
    def fetch(self, video_id: str, languages: Iterable[str] = ..., preserve_formatting: bool = ...) -> FetchedTranscript: ...
    def list_transcripts(self, video_id: str) -> TranscriptList: ...
    @classmethod
    def list_transcripts(cls, video_id: str, proxies: Optional[Dict[str, str]] = ...) -> TranscriptList: ...
    @classmethod
    def get_transcripts(cls, video_ids: List[str], languages: Iterable[str] = ..., continue_after_error: bool = ..., proxies: Optional[Dict[str, str]] = ..., preserve_formatting: bool = ...) -> Tuple[Dict[str, List[Dict]], List[str]]: ...
    @classmethod
    def get_transcript(cls, video_id: str, languages: Iterable[str] = ..., proxies: Optional[Dict[str, str]] = ..., preserve_formatting: bool = ...) -> List[Dict]: ...
