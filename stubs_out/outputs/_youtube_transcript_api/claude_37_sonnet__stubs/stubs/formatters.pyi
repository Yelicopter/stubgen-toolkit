from ._transcripts import FetchedTranscript as FetchedTranscript, FetchedTranscriptSnippet as FetchedTranscriptSnippet
from typing import Dict, Iterable, Type

class Formatter:
    def format_transcript(self, transcript: FetchedTranscript, **kwargs) -> str: ...
    def format_transcripts(self, transcripts: Iterable[FetchedTranscript], **kwargs) -> str: ...

class PrettyPrintFormatter(Formatter):
    def format_transcript(self, transcript: FetchedTranscript, **kwargs) -> str: ...
    def format_transcripts(self, transcripts: Iterable[FetchedTranscript], **kwargs) -> str: ...

class JSONFormatter(Formatter):
    def format_transcript(self, transcript: FetchedTranscript, **kwargs) -> str: ...
    def format_transcripts(self, transcripts: Iterable[FetchedTranscript], **kwargs) -> str: ...

class TextFormatter(Formatter):
    def format_transcript(self, transcript: FetchedTranscript, **kwargs) -> str: ...
    def format_transcripts(self, transcripts: Iterable[FetchedTranscript], **kwargs) -> str: ...

class _TextBasedFormatter(TextFormatter):
    def format_transcript(self, transcript: FetchedTranscript, **kwargs) -> str: ...

class SRTFormatter(_TextBasedFormatter): ...
class WebVTTFormatter(_TextBasedFormatter): ...

class FormatterLoader:
    TYPES: Dict[str, Type[Formatter]]
    class UnknownFormatterType(Exception):
        def __init__(self, formatter_type: str) -> None: ...
    def load(self, formatter_type: str = ...) -> Formatter: ...
